[Unit]
Description=Memory API (Go)
After=network.target postgresql.service

[Service]
Type=simple
User={{ app_user }}
EnvironmentFile=/etc/memory-api/env
ExecStart={{ go_server_bin }}
Restart=on-failure
RestartSec=5
# The server sends "WATCHDOG=1" from its own process (internal/watchdog), so
# the default NotifyAccess=main is enough.
WatchdogSec=60
NotifyAccess=main

[Install]
WantedBy=multi-user.target
